<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#100f0c"
  android:orientation="vertical"
  android:padding="24dp">

  <LinearLayout
    android:id="@+id/blocker_main_content"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
      android:id="@+id/blocker_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/blocker_title"
      android:textColor="#f8fafc"
      android:textSize="22sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/blocker_subtitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/blocker_subtitle"
      android:textColor="#94a3b8"
      android:textSize="14sp"
      android:gravity="center" />

    <Button
      android:id="@+id/blocker_open_app"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:text="@string/blocker_open_app"
      android:backgroundTint="#f59e0b"
      android:textColor="#0b1020" />

    <Button
      android:id="@+id/blocker_button"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/blocker_back"
      android:backgroundTint="#1f2937"
      android:textColor="#f8fafc" />

  </LinearLayout>

  <LinearLayout
    android:id="@+id/blocker_credit_section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="4dp"
    android:layout_marginHorizontal="18dp"
    android:orientation="vertical"
    android:visibility="gone"
    android:padding="12dp"
    android:background="#1b2432"
    android:gravity="center_horizontal">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/preface_credit_title"
      android:textColor="#f8fafc"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="@string/preface_credit_label"
      android:textColor="#cbd5f5"
      android:textSize="12sp"
      android:gravity="center" />

    <Button
      android:id="@+id/blocker_credit_button"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/preface_credit_button"
      android:backgroundTint="#f59e0b"
      android:textColor="#0b1020" />

    <TextView
      android:id="@+id/blocker_credit_penalty"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="@string/preface_credit_penalty"
      android:textColor="#f8fafc"
      android:textSize="11sp" />

    <TextView
      android:id="@+id/blocker_credit_lock_notice"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:text="@string/preface_credit_locked"
      android:textColor="#94a3b8"
      android:textSize="10sp"
      android:visibility="gone" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/blocker_sick_section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="8dp"
    android:layout_marginHorizontal="18dp"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#0f172a"
    android:gravity="center_horizontal">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/blocker_sick_title"
      android:textColor="#f8fafc"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:text="@string/blocker_sick_label"
      android:textColor="#cbd5f5"
      android:textSize="13sp"
      android:gravity="center" />

    <TextView
      android:id="@+id/blocker_sick_hint"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="@string/blocker_sick_hint"
      android:textColor="#94a3b8"
      android:textSize="12sp"
      android:gravity="center" />

    <Button
      android:id="@+id/blocker_sick_button"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:text="@string/blocker_sick_button"
      android:backgroundTint="#14b8a6"
      android:textColor="#0b1020" />

    <TextView
      android:id="@+id/blocker_sick_status"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:text="@string/blocker_sick_status"
      android:textColor="#34d399"
      android:textSize="11sp"
      android:visibility="gone" />
  </LinearLayout>
</LinearLayout>
